{
  "private": true,
  "workspaces": [
    "packages/dsh-plugin"
  ],
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun run --cwd packages/dsh-plugin build",
    "typecheck": "bun run --cwd packages/dsh-plugin typecheck",
    "test": "bun run --cwd packages/dsh-plugin test",
    "lint": "bun run --cwd packages/dsh-plugin lint",
    "lint:fix": "bun run --cwd packages/dsh-plugin lint:fix",
    "docs:check": "bun run --cwd packages/dsh-plugin docs:check",
    "test:install": "bun run --cwd packages/dsh-plugin test:install",
    "benchmark": "bun run --cwd packages/dsh-plugin benchmark",
    "test:live": "bun run --cwd packages/dsh-plugin test:live",
    "structure:check": "node packages/dsh-plugin/scripts/verify-project.mjs",
    "check": "bun run typecheck && bun run lint && bun run test && bun run docs:check && bun run structure:check",
    "check:dsh": "bun run check",
    "test:rollback": "bun run --cwd packages/dsh-plugin test:rollback"
  }
}
